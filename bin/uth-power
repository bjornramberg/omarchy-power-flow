#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$(uname -m)" in
  x86_64|amd64)
    binary="$script_dir/uth-power-linux-amd64"
    ;;
  aarch64|arm64)
    binary="$script_dir/uth-power-linux-arm64"
    ;;
  *)
    printf 'uth-power: unsupported architecture: %s\n' "$(uname -m)" >&2
    exit 127
    ;;
esac

if [ ! -x "$binary" ]; then
  printf 'uth-power: missing executable: %s\n' "$binary" >&2
  exit 127
fi

exec "$binary" "$@"
