{
  // UTH Power row for the Omarchy/Quickshell Super-key menu.
  //
  // Merge this object into ~/.config/omarchy/extensions/omarchy-menu.jsonc,
  // or run scripts/install-menu-entry.sh to splice it in automatically.
  //
  // Keep the id at the root level. "uth-power" is intentional: a dotted id
  // such as "uth.power" would make the menu infer a parent submenu.
  "uth-power": {
    // Nerd Font bolt U+F0E7
    "icon": "",
    "label": "UTH Power",
    "description": "Live component power-flow panel",
    "action": "omarchy-shell shell toggle uth.power",
    "when": "test -f \"$HOME/.config/omarchy/plugins/uth.power/manifest.json\""
  }
}
